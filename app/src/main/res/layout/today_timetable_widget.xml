<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tt_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/today_timetable_background"
    android:paddingHorizontal="14dp" android:paddingVertical="@dimen/tt_widget_vertical_padding">
    <LinearLayout android:id="@+id/tt_widget_header"
        android:layout_width="match_parent" android:layout_height="@dimen/tt_widget_header_height"
        android:gravity="top" android:orientation="horizontal" android:baselineAligned="false">
        <TextView android:id="@+id/tt_widget_date" style="@style/TimetableWidgetDate"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="start" android:text="@string/timetable_widget_name" />
        <TextView android:id="@+id/tt_widget_more" style="@style/TimetableWidgetDate"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingHorizontal="5dp" android:paddingVertical="1dp" android:visibility="gone"
            android:background="@drawable/today_timetable_period_badge" android:textColor="@color/tt_widget_accent" />
    </LinearLayout>
    <LinearLayout android:id="@+id/tt_widget_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" />
    <TextView android:id="@+id/tt_widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="@dimen/tt_widget_row_height" android:gravity="start|center_vertical"
        android:textColor="@color/tt_widget_detail" android:textSize="14sp" android:text="正在读取课表…" />
</LinearLayout>
