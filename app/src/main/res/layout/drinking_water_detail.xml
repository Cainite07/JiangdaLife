<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/water_tile" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="7dp"
    android:background="@drawable/water_widget_tile" android:foreground="@drawable/water_widget_press">
    <ImageView android:id="@+id/water_tile_icon" android:layout_width="15dp" android:layout_height="15dp"
        android:layout_marginEnd="7dp" android:src="@drawable/ic_widget_water_drop"
        android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/water_tile_type" style="@style/TimetableWidgetHeading"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="start" android:textSize="13sp" />
        <TextView android:id="@+id/water_tile_device" style="@style/TimetableWidgetDate"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:gravity="start" />
    </LinearLayout>
    <TextView android:id="@+id/water_tile_action" style="@style/TimetableWidgetHeading"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
        android:paddingHorizontal="7dp" android:paddingVertical="4dp" android:textSize="13sp"
        android:background="@drawable/water_widget_action" />
</LinearLayout>
