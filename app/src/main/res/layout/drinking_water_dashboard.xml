<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/water_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="7dp" android:background="@drawable/water_widget_background">
    <FrameLayout android:id="@+id/water_widget_cold" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="3dp" />
    <FrameLayout android:id="@+id/water_widget_hot" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="2dp" />
</LinearLayout>
