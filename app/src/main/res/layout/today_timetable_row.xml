<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tt_widget_row" android:layout_width="match_parent" android:layout_height="@dimen/tt_widget_row_height"
    android:orientation="vertical" android:gravity="center_vertical">
    <TextView android:id="@+id/tt_widget_course" style="@style/TimetableWidgetCourse"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" />
    <TextView android:id="@+id/tt_widget_room" style="@style/TimetableWidgetDate"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:gravity="start" />
    <TextView android:id="@+id/tt_widget_time" style="@style/TimetableWidgetDate"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:gravity="start" android:textColor="@color/tt_widget_accent" />
</LinearLayout>
