<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tt_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:paddingHorizontal="12dp"
    android:paddingVertical="4dp" android:background="@drawable/today_timetable_background">
    <TextView android:id="@+id/tt_compact_caption" style="@style/TimetableWidgetDate"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
    <TextView android:id="@+id/tt_compact_course" style="@style/TimetableWidgetCourse"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="start" android:singleLine="false" android:maxLines="2"
        android:textSize="14sp" android:text="@string/timetable_widget_name" />
    <TextView android:id="@+id/tt_compact_room" style="@style/TimetableWidgetDate"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:gravity="start" android:visibility="gone" />
    <TextView android:id="@+id/tt_widget_time" style="@style/TimetableWidgetDate"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:gravity="start" android:visibility="gone"
        android:textColor="@color/tt_widget_accent" />
</LinearLayout>
