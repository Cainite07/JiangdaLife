<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tt_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingHorizontal="7dp" android:paddingVertical="10dp"
    android:background="@drawable/today_timetable_background">
    <TextView android:id="@+id/tt_compact_caption" style="@style/TimetableWidgetDate"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="start" android:textSize="10sp" />
    <TextView android:id="@+id/tt_compact_course" style="@style/TimetableWidgetCourse"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:gravity="start" android:singleLine="false"
        android:breakStrategy="simple" android:maxLines="3" android:textSize="13sp" />
    <TextView android:id="@+id/tt_compact_room" style="@style/TimetableWidgetDate"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:gravity="start" android:singleLine="false"
        android:breakStrategy="simple" android:maxLines="3" android:textSize="10sp" />
    <TextView android:id="@+id/tt_widget_time" style="@style/TimetableWidgetDate"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:gravity="start" android:singleLine="false"
        android:maxLines="2" android:textSize="10sp" />
</LinearLayout>
